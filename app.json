{
  "expo": {
    "name": "Hijra",
    "owner": "kalindigital30",
    "slug": "hijrah-apps",
    "version": "0.9.0",
    "scheme": "hijrah",
    "icon": "./assets/branding/logo_hijra.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.hijrah.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "locales": {
      "id": "./src/locales/id/native.json",
      "en": "./src/locales/en/native.json"
    },
    "android": {
      "package": "app.hijrah.mobile",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Hijra to use your location on this device to calculate the Qibla direction.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#174638",
          "image": "./assets/branding/logo_hijra.png",
          "imageWidth": 176,
          "dark": {
            "backgroundColor": "#174638",
            "image": "./assets/branding/logo_hijra.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Hijra to choose a local profile photo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d679a5eb-5ad3-4d70-9c33-4ab31df089f3"
      }
    }
  }
}
